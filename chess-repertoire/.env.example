# Copy to .env for local overrides (optional). Render/Netlify set these in their dashboards.

# Required in production (Render auto-generates via render.yaml)
SECRET_KEY=

# Google Identity Services client ID (OAuth 2.0 Web client).
# Required for "Continue with Google". Create in Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: http://127.0.0.1:5000 and your site URL.
GOOGLE_CLIENT_ID=

# production | development
FLASK_ENV=development

# Comma-separated origins for direct cross-origin API access (optional).
# Not needed when using the Netlify /api/* proxy (recommended).
# CORS_ORIGINS=https://your-domain.com,https://your-site.netlify.app

# Optional frontend direct API base (window.OPENING_EXPLORER_API or
# <meta name="opening-explorer-api" content="https://...">). Prefer same-origin
# /api proxy; only set this when the SPA must call Render without a proxy.
# API_BASE=

# Override Stockfish binary path (optional; Linux build lands in engine/linux/stockfish)
# STOCKFISH_PATH=
# Optional second binary tried if primary fails to spawn (also installed by download script).
# STOCKFISH_FALLBACK_PATH=
# STOCKFISH_FALLBACK_VERSION=sf_16

# In-process Stockfish pool (per gunicorn worker). Keep workers=1 while using this.
# ENGINE_POOL_SIZE=2
# ENGINE_THREADS=1
# ENGINE_HASH_MB=16
# Start + analyse smoke at boot (default on in production).
# ENGINE_WARMUP=1
# Auto-run scripts/download_stockfish.sh when no binary is found (default on Linux).
# ENGINE_DOWNLOAD_ON_MISSING=1
# /api/health returns 503 when Stockfish cannot start (default on in production).
# HEALTH_REQUIRE_ENGINE=1

# Bounded async job thread pool (report / scan jobs; state in SQLite async_jobs).
# JOB_WORKERS=2

# Rate limits (requests per minute per user-or-IP).
# RATE_LIMIT_ENGINE=30
# RATE_LIMIT_REPORT=10
# RATE_LIMIT_AUTH=20

# Reuse chess.com current-month disk cache for this many seconds (0 = always re-fetch).
# CURRENT_MONTH_CACHE_SECONDS=900

# Disk cache quotas for .chesscom-cache (month JSON archives).
# CACHE_MAX_MB=400
# CACHE_MAX_FILES=2000

# Run Alembic on boot (default: on unless FLASK_ENV=production).
# AUTO_MIGRATE=1

# Persistent data root on Render (users.db + .chesscom-cache). Local dev uses repo defaults.
# DATA_DIR=/data

# Pin Stockfish release tag for scripts/download_stockfish.sh (default: sf_17.1)
# STOCKFISH_VERSION=sf_17.1

# Stripe billing (Pro: My Repertoire — $6/mo or $40/yr, 3-day free trial on first checkout).
# When unset, Pro gates are disabled (local/dev).
# Create Product "Opening Explorer Pro" with two recurring prices; paste price_… IDs below.
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_MONTHLY=price_…
# STRIPE_PRICE_YEARLY=price_…
# PUBLIC_APP_URL=https://opening-explorer.com
# Optional extra CORS origins (comma-separated) if the frontend calls Render directly:
# CORS_ORIGINS=https://opening-explorer.com,https://www.opening-explorer.com
# Webhook URL (prefer Render direct): https://<render-host>/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted

# Required to see ops tools in Profile (account roster, set temporary passwords).
# Must match the email you sign in with. If unset, ops UI is hidden from everyone.
# ANALYTICS_ADMIN_EMAIL=you@example.com

# PostHog product analytics (People, Insights, Retention, Session Replay).
# Create a project at https://us.posthog.com (or eu.posthog.com) → Project
# settings → Project API Key (phc_…). Public client key — safe in the browser.
# Off unless set. EU cloud: POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_PROJECT_API_KEY=phc_xxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics (GA4) measurement ID — traffic/audience reporting in the
# Google Analytics dashboard (not a substitute for PostHog People profiles).
# A production default is already baked into webapp/app.py (used only when
# FLASK_ENV=production), so this is only needed to override it
# (e.g. point at your own/staging GA4 property). Create a GA4 property + web
# data stream at https://analytics.google.com -> Admin -> Data Streams.
# When unset AND not FLASK_ENV=production, no Google Analytics script loads.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
