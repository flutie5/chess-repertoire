# Copy to .env for local overrides (optional). Render/Netlify set these in their dashboards.

# Required in production (Render auto-generates via render.yaml)
SECRET_KEY=

# production | development
FLASK_ENV=development

# Comma-separated origins for direct cross-origin API access (optional).
# Not needed when using the Netlify /api/* proxy (recommended).
# CORS_ORIGINS=https://your-domain.com,https://your-site.netlify.app

# Override API base URL for frontend builds (optional; proxy-only deploys leave this unset).
# API_BASE=

# Override Stockfish binary path (optional; Linux build lands in engine/linux/stockfish)
# STOCKFISH_PATH=

# Persistent data root on Render (users.db + .chesscom-cache). Local dev uses repo defaults.
# DATA_DIR=/data

# Pin Stockfish release tag for scripts/download_stockfish.sh (default: sf_17.1)
# STOCKFISH_VERSION=sf_17.1
