# Copy to .env for local overrides (optional). Render/Netlify set these in their dashboards.

# Required in production (Render auto-generates via render.yaml)
SECRET_KEY=

# Google Identity Services client ID (OAuth 2.0 Web client).
# Required for "Continue with Google". Create in Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: http://127.0.0.1:5000 and your site URL.
GOOGLE_CLIENT_ID=

# production | development
FLASK_ENV=development

# Comma-separated origins for direct cross-origin API access (optional).
# Not needed when using the Netlify /api/* proxy (recommended).
# CORS_ORIGINS=https://your-domain.com,https://your-site.netlify.app

# Override API base URL for frontend builds (optional; proxy-only deploys leave this unset).
# API_BASE=

# Override Stockfish binary path (optional; Linux build lands in engine/linux/stockfish)
# STOCKFISH_PATH=

# Persistent data root on Render (users.db + .chesscom-cache). Local dev uses repo defaults.
# DATA_DIR=/data

# Pin Stockfish release tag for scripts/download_stockfish.sh (default: sf_17.1)
# STOCKFISH_VERSION=sf_17.1

# Stripe billing (Pro: $6/mo or $40/yr). When unset, Pro gates are disabled (local/dev).
# Create Product "Opening Explorer Pro" with two recurring prices; paste price_… IDs below.
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_MONTHLY=price_…
# STRIPE_PRICE_YEARLY=price_…
# PUBLIC_APP_URL=https://opening-explorer.com
# Optional extra CORS origins (comma-separated) if the frontend calls Render directly:
# CORS_ORIGINS=https://opening-explorer.com,https://www.opening-explorer.com
# Webhook URL (prefer Render direct): https://<render-host>/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
